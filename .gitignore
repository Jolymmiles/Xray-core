# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# macOS specific files
.DS_Store

# IDE/editor specific files
.idea/
.vscode/
*.swp
*.swo

# Personal agent settings and local agent state. Shared agent configuration
# (.claude/agents, .claude/skills, .codex/config.toml) is committed.
/.claude/settings.local.json
/.claude/worktrees/
/.pi/fabric/
/.scratch/

# Generated codebase analysis output
**/graphify-out/

# Archives and compressed files
*.zip
*.tar.gz
*.tar
*.gz
*.bz2

# Go build binaries
xray
xray_softfloat
mockgen
vprotogen
!infra/vprotogen/
errorgen
!common/errors/errorgen/
*.dat

# Build assets
/build_assets/
/build/
/dist/
/out/

# Downloaded runtime assets
/resources/

# Output from dlv test
**/debug.*

# Certificates and keys
*.crt
*.key

# Dependency directories (uncomment if needed)
# vendor/

# Local Go workspace files
/go.work
/go.work.sum

# Python bytecode caches
__pycache__/
*.py[cod]

# Logs
*.log

# Coverage reports
coverage.*
*.coverprofile

# Profiles, traces, and runtime state
*.prof
*.pprof
*.trace
*.pid
*.pid.lock
*.sock

# Node modules (in case of frontend assets)
node_modules/

# System files
Thumbs.db
ehthumbs.db

# Other common ignores
*.bak
*.tmp
*.orig
*.rej
*~
/.cache/
/tmp/

# Local environment files
.env
.env.*
!.env.example

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
