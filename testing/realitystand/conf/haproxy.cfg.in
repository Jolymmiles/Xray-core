global
	maxconn 256
defaults
	mode http
	timeout connect 5s
	timeout client 30s
	timeout server 30s
	timeout http-keep-alive 2s
frontend fe
	bind 10.9.0.13:443 ssl crt @WORK@/certs/real/rsa-haproxy.pem alpn h2,http/1.1
	http-request return status 200 content-type text/html file @WORK@/www/page.html
