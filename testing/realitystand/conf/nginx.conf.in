user root root;
worker_processes 1;
pid @WORK@/runs/nginx.pid;
error_log @WORK@/runs/nginx-error.log warn;
events { worker_connections 256; }
http {
  access_log off;
  client_body_temp_path @WORK@/runs/nginx-tmp/body;
  proxy_temp_path @WORK@/runs/nginx-tmp/proxy;
  fastcgi_temp_path @WORK@/runs/nginx-tmp/fastcgi;
  uwsgi_temp_path @WORK@/runs/nginx-tmp/uwsgi;
  scgi_temp_path @WORK@/runs/nginx-tmp/scgi;
  keepalive_timeout 2s;
  server {
    listen 10.9.0.11:443 ssl;
    http2 on;
    server_name nginx.example.test;
    ssl_certificate @WORK@/certs/real/rsa-chain.pem;
    ssl_certificate_key @WORK@/certs/real/rsa.key;
    root @WORK@/www;
  }
  server {
    listen 10.9.0.14:443 ssl;
    http2 on;
    server_name nginxshort.example.test;
    ssl_certificate @WORK@/certs/real/rsa-chain.pem;
    ssl_certificate_key @WORK@/certs/real/rsa.key;
    ssl_session_timeout 8s;
    root @WORK@/www;
  }
  # the operator's own site behind REALITY on the same server
  # As the guides for a site of one's own behind REALITY set it up: Mozilla's
  # "intermediate" TLS settings, nginx's own keepalive.
  server {
    listen 127.0.0.1:8443 ssl;
    http2 on;
    server_name stub.example.test;
    ssl_certificate @WORK@/certs/real/rsa-chain.pem;
    ssl_certificate_key @WORK@/certs/real/rsa.key;
    ssl_session_timeout 1d;
    ssl_session_cache shared:MozSSL:10m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    keepalive_timeout 75s;
    root @WORK@/stub;
  }
}
